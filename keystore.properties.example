# Release signing credentials. Copy to keystore.properties (git-ignored) and
# fill in, or set the equivalent environment variables instead:
#
#   TILEDPLAYER_STORE_FILE, TILEDPLAYER_STORE_PASSWORD,
#   TILEDPLAYER_KEY_ALIAS, TILEDPLAYER_KEY_PASSWORD
#
# storeFile is resolved relative to the project root. If neither this file nor
# the env vars are present, `assembleRelease` falls back to the debug key.

storeFile=tiled-player-release.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password

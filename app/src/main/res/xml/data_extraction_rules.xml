<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Nothing this app stores should ever leave
  the device: the imported video copies, their index, and the ratings all live
  in internal storage precisely so they stay on this phone. allowBackup="false"
  already covers cloud backup; device-to-device transfer is governed here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
